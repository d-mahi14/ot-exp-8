--- clean-xv6/user/bcachetest.c	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/c/dev/ot-8/track_G_xv6/xv6-riscv/user/bcachetest.c	2026-10-21 18:41:09.495021100 +0000
@@ -0,0 +1,109 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/pstat.h"
+#include "kernel/fs.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+#define BLOCK_SIZE 1024
+
+void
+write_file(const char *path, int num_blocks)
+{
+  char buf[BLOCK_SIZE];
+  memset(buf, 'A', sizeof(buf));
+  int fd = open(path, O_CREATE | O_WRONLY);
+  if (fd < 0) {
+    printf("error opening %s for write\n", path);
+    exit(1);
+  }
+  for (int i = 0; i < num_blocks; i++) {
+    buf[0] = (char)('A' + (i % 26));
+    if (write(fd, buf, BLOCK_SIZE) != BLOCK_SIZE) {
+      printf("write error in block %d\n", i);
+      close(fd);
+      exit(1);
+    }
+  }
+  close(fd);
+}
+
+void
+read_file(const char *path, int num_blocks)
+{
+  char buf[BLOCK_SIZE];
+  int fd = open(path, O_RDONLY);
+  if (fd < 0) {
+    printf("error opening %s for read\n", path);
+    exit(1);
+  }
+  for (int i = 0; i < num_blocks; i++) {
+    if (read(fd, buf, BLOCK_SIZE) != BLOCK_SIZE) {
+      break;
+    }
+  }
+  close(fd);
+}
+
+int
+main(int argc, char *argv[])
+{
+  struct bcache_stats st0, st1, st2, st3;
+
+  printf("=== xv6 Buffer Cache Instrumentation Benchmark ===\n");
+
+  // Step 1: Baseline / Initial stats
+  if (getbcachestats(&st0) < 0) {
+    printf("getbcachestats failed!\n");
+    exit(1);
+  }
+  printf("Initial stats: lookups=%ld hits=%ld misses=%ld writes=%ld\n",
+         st0.lookups, st0.hits, st0.misses, st0.writes);
+
+  // Step 2: Write a working set file (15 blocks, comfortably within NBUF=30)
+  printf("Writing 15-block working set file...\n");
+  write_file("cache_ws.dat", 15);
+
+  // Step 3: First read pass (warm-up pass)
+  read_file("cache_ws.dat", 15);
+  getbcachestats(&st1);
+  uint64 d_lookups1 = st1.lookups - st0.lookups;
+  uint64 d_hits1 = st1.hits - st0.hits;
+  uint64 d_misses1 = st1.misses - st0.misses;
+  printf("Pass 1 (Warmup): lookups=%ld hits=%ld misses=%ld\n",
+         d_lookups1, d_hits1, d_misses1);
+
+  // Step 4: Second read pass (cached / warm pass)
+  read_file("cache_ws.dat", 15);
+  getbcachestats(&st2);
+  uint64 d_lookups2 = st2.lookups - st1.lookups;
+  uint64 d_hits2 = st2.hits - st1.hits;
+  uint64 d_misses2 = st2.misses - st1.misses;
+  int hit_pct = d_lookups2 > 0 ? (int)((d_hits2 * 100) / d_lookups2) : 0;
+  printf("Pass 2 (Cached): lookups=%ld hits=%ld misses=%ld hit_pct=%d%%\n",
+         d_lookups2, d_hits2, d_misses2, hit_pct);
+  printf("RESULT_BCACHE phase=warm lookups=%ld hits=%ld misses=%ld hit_pct=%d\n",
+         d_lookups2, d_hits2, d_misses2, hit_pct);
+
+  // Step 5: Thrashing pass (40 blocks, exceeds NBUF=30)
+  printf("Writing 40-block thrash file (> NBUF 30)...\n");
+  write_file("cache_thrash.dat", 40);
+  getbcachestats(&st2); // re-baseline before read
+  read_file("cache_thrash.dat", 40);
+  getbcachestats(&st3);
+  uint64 d_lookups3 = st3.lookups - st2.lookups;
+  uint64 d_hits3 = st3.hits - st2.hits;
+  uint64 d_misses3 = st3.misses - st2.misses;
+  int thrash_miss_pct = d_lookups3 > 0 ? (int)((d_misses3 * 100) / d_lookups3) : 0;
+  printf("Pass 3 (Thrash): lookups=%ld hits=%ld misses=%ld miss_pct=%d%%\n",
+         d_lookups3, d_hits3, d_misses3, thrash_miss_pct);
+  printf("RESULT_BCACHE phase=thrash lookups=%ld hits=%ld misses=%ld miss_pct=%d\n",
+         d_lookups3, d_hits3, d_misses3, thrash_miss_pct);
+
+  // Clean up files
+  unlink("cache_ws.dat");
+  unlink("cache_thrash.dat");
+
+  printf("=== Buffer Cache Benchmark Completed ===\n");
+  exit(0);
+}
