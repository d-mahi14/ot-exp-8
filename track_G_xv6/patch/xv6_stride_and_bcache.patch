+// Set tickets (1..100) for a process
+int
+setpriority(int pid, int tickets)
+{
+  if (tickets < 1 || tickets > 100)
+    return -1;
+
+  struct proc *p;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->pid == pid) {
+      p->tickets = tickets;
+      p->stride = 10000 / tickets;
+      release(&p->lock);
+      return 0;
+    }
+    release(&p->lock);
+  }
+  return -1;
+}
+
+// Retrieve process table scheduling statistics
+int
+getpinfo(uint64 addr)
+{
+  struct proc *curr = myproc();
+  struct pstat ps;
+  struct proc *p;
+  int i = 0;
+
+  memset(&ps, 0, sizeof(ps));
+
+  for (p = proc; p < &proc[NPROC]; p++, i++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED) {
+      ps.inuse[i] = 1;
+      ps.pid[i] = p->pid;
+      ps.tickets[i] = p->tickets;
+      ps.stride[i] = p->stride;
+      ps.pass[i] = p->pass;
+      ps.rtime[i] = p->rtime;
+    } else {
+      ps.inuse[i] = 0;
+    }
+    release(&p->lock);
+  }
+
+  if (copyout(curr->pagetable, curr->sz, addr, (char *)&ps, sizeof(ps)) < 0)
+    return -1;
+
+  return 0;
+}
