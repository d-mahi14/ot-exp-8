+#ifndef _PSTAT_H_
+#define _PSTAT_H_
+
+#include "param.h"
+
+struct pstat {
+  int inuse[NPROC];   // whether this slot of the process table is in use (1 or 0)
+  int pid[NPROC];     // PID of each process
+  int tickets[NPROC]; // tickets of each process
+  int stride[NPROC];  // stride of each process
+  int pass[NPROC];    // current pass value
+  int rtime[NPROC];   // total ticks process has accumulated
+};
+
+struct bcache_stats {
+  uint64 lookups;
+  uint64 hits;
+  uint64 misses;
+  uint64 writes;
+};
+
+#endif
