+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/pstat.h"
+#include "user/user.h"
+
+#define NCHILD 3
+
+void
+spin_work(int iterations)
+{
+  volatile long sum = 0;
+  for (volatile int i = 0; i < iterations; i++) {
+    sum += (i * 3) ^ (i >> 2);
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int tickets[NCHILD] = {10, 20, 30};
+  int pids[NCHILD];
+
+  printf("=== xv6 Stride Scheduling Benchmark ===\n");
+  printf("Configured %d processes with tickets 10 : 20 : 30 (1 : 2 : 3)\n", NCHILD);
+
+  // Set parent priority to default
+  setpriority(getpid(), 10);
+  int t0 = uptime();
+
+  for (int i = 0; i < NCHILD; i++) {
+    int pid = fork();
+    if (pid < 0) {
+      printf("fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      // Child process sets its priority/tickets
+      int mypid = getpid();
+      if (setpriority(mypid, tickets[i]) < 0) {
+        printf("setpriority failed for child %d\n", i);
+        exit(1);
+      }
+
+      // Execute compute-intensive workload
+      spin_work(350000000);
+
+      int t_finish = uptime();
+      int turnaround = t_finish - t0;
+
+      // Query process telemetry before exit
+      struct pstat ps;
+      if (getpinfo(&ps) == 0) {
+        for (int j = 0; j < NPROC; j++) {
+          if (ps.inuse[j] && ps.pid[j] == mypid) {
+            printf("RESULT_SCHED child=%d pid=%d tickets=%d stride=%d pass=%d rtime=%d turnaround=%d\n",
+                   i + 1, mypid, ps.tickets[j], ps.stride[j], ps.pass[j], ps.rtime[j], turnaround);
+            break;
+          }
+        }
+      }
+      exit(0);
+    }
+    pids[i] = pid;
+  }
+
+  // Parent takes a concurrent progress snapshot during execution
+  pause(8); // wait ~8 ticks for concurrent execution
+  struct pstat snap_ps;
+  if (getpinfo(&snap_ps) == 0) {
+    int snap_rtime[NCHILD] = {0, 0, 0};
+    for (int j = 0; j < NPROC; j++) {
+      for (int k = 0; k < NCHILD; k++) {
+        if (snap_ps.inuse[j] && snap_ps.pid[j] == pids[k]) {
+          snap_rtime[k] = snap_ps.rtime[j];
+        }
+      }
+    }
+    printf("SNAPSHOT_SCHED rtime1=%d rtime2=%d rtime3=%d\n",
+           snap_rtime[0], snap_rtime[1], snap_rtime[2]);
+  }
+
+  // Parent waits for all children
+  for (int i = 0; i < NCHILD; i++) {
+    wait(0);
+  }
+
+  printf("=== Benchmark Completed Successfully ===\n");
+  exit(0);
+}
